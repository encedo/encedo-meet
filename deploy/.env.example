# ============================================================
# Encedo Meet — konfiguracja deploymentu
# Skopiuj do .env i uzupełnij
# ============================================================

# Domeny
MEET_DOMAIN=meet.encedo.com
MEET_DOMAIN_URL=https://meet.encedo.com
API_DOMAIN=api.meet.encedo.com

# Let's Encrypt
LETSENCRYPT_EMAIL=admin@encedo.com

# Wersja obrazów Jitsi (unstable = najnowsza, lub np. stable-9646)
JITSI_IMAGE_VERSION=unstable

# Katalog konfiguracji Jitsi (prosody/jicofo/jvb state)
CONFIG=~/.jitsi-meet-cfg

# Strefa czasowa
TZ=Europe/Warsaw

# ============================================================
# KRYTYCZNE — wygeneruj losowe hasła:
#   openssl rand -hex 16
# ============================================================
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

# Publiczny IP serwera — sprawdź: curl ifconfig.me
JVB_ADVERTISE_IPS=

# Port UDP dla mediów JVB
JVB_PORT=10000
